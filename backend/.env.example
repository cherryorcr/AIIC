APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_PATH=/app/data/app.db
# Set this in production to use PostgreSQL. Leave blank for SQLite development.
DATABASE_URL=
INTERVIEW_DATASET_PATH=/app/data/mock-interview-dataset.json

# 强模型。不要把真实 key 提交到 Git；部署时通过服务器环境变量或 secret 注入。
STRONG_MODEL_BASE_URL=https://jojocode.com/v1
STRONG_MODEL_API_KEY=
STRONG_MODEL_NAME=gpt-4o-mini

# 双 4090 服务器上的 OpenAI-compatible 弱模型网关；部署时可填写：
# LOCAL_MODEL_BASE_URL=http://100.126.175.112:8000/v1
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_API_KEY=
LOCAL_MODEL_NAME=local-interview
MODEL_TIMEOUT_SECONDS=30
MODEL_STRICT=false

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ADMIN_TOKEN=
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=3
SANDBOX_MAX_OUTPUT_BYTES=20000
DOCUMENT_MAX_BYTES=5242880
DOCUMENT_MAX_TEXT_CHARS=40000
